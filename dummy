import org.apache.spark.sql.DataFrame
import org.apache.spark.sql.functions._

def applyScd2(
    primaryKeys: Seq[String],
    lmo: DataFrame,
    emo: DataFrame
): DataFrame = {

  val EffStart    = "effective_start_date"
  val EffEnd      = "effective_end_date"
  val CurrentFlag = "current_flag"
  val EndOfTime   = "2099-12-31"

  // change detection uses every lmo column that isn't a primary key or an SCD2 tracking column
  val excludedColumns = primaryKeys.toSet ++ Set(EffStart, EffEnd, CurrentFlag)
  val changeColumns    = lmo.columns.filterNot(excludedColumns.contains).toSeq

  val activeEmo   = emo.filter(col(CurrentFlag) === "Y")
  val inactiveEmo = emo.filter(col(CurrentFlag) =!= "Y")

  // brand new keys: in lmo but not in active emo
  val newRecords = lmo.join(activeEmo, primaryKeys, "left_anti")

  // keys present in both, but changed: match on PK, then anti-join on PK+all other cols
  // (i.e. present with same PK, but not present with identical PK+attribute combo)
  val matchedByPk    = lmo.join(activeEmo, primaryKeys, "left_semi")
  val changedRecords = matchedByPk.join(activeEmo, primaryKeys ++ changeColumns, "left_anti")

  // active emo rows that must be expired = the "before" image of changedRecords
  val toExpire = activeEmo
    .join(changedRecords, primaryKeys, "left_semi")
    .withColumn(EffEnd, date_sub(current_date(), 1))
    .withColumn(CurrentFlag, lit("N"))

  // active emo rows untouched this run
  val stillActive = activeEmo.join(changedRecords, primaryKeys, "left_anti")

  // new "current" versions for both new and changed keys
  val newVersions = changedRecords.unionByName(newRecords)
    .withColumn(EffStart, current_date())
    .withColumn(EffEnd, to_date(lit(EndOfTime)))
    .withColumn(CurrentFlag, lit("Y"))

  inactiveEmo
    .unionByName(stillActive)
    .unionByName(toExpire)
    .unionByName(newVersions)
}
